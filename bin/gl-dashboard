#!/usr/bin/env python3
"""Linear ticket status page for the ghostty-linear tmux workflow.

Lists assigned + active tickets, badges the ones with a live claude session,
shows PR # + CI status. Up/Down paginate, Enter opens/attaches, y splits.
"""
import curses
import json
import os
import re
import subprocess
import textwrap
import time

TICKET_RE = re.compile(r"^[A-Za-z]+-\d+$")

HOME = os.path.expanduser("~")
CACHE = os.environ.get("GL_CACHE", os.path.join(HOME, ".cache/ghostty-linear"))
BIN = os.path.dirname(os.path.abspath(__file__))
TICKETS = os.path.join(CACHE, "tickets.json")
AGENTS = os.path.join(CACHE, "agents.json")
SELECTED = os.path.join(CACHE, "selected")
ORDER = os.path.join(CACHE, "order")
UNREAD_DIR = os.path.join(CACHE, "unread")             # one file per unread id
CONFIG_DIR = os.path.dirname(BIN)                       # …/ghostty-linear
BLOCKS_DIR = os.path.join(CONFIG_DIR, "blocks")         # user-authored blocks
BLOCKS_REGISTRY = os.path.join(CONFIG_DIR, "blocks.json")
SESSION = os.environ.get("GL_SESSION", "hazel")
TMUX = os.environ.get("TMUX_BIN") or "tmux"

REFETCH_SECONDS = 180

# Linear states never worth showing, matched by name (case-insensitive) so they
# stay hidden regardless of how the workspace types them.
HIDDEN_STATES = {"cancelled", "canceled", "closed", "duplicate"}


def load_tickets():
    try:
        with open(TICKETS) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return []
    return [t for t in data
            if (t.get("state") or "").strip().lower() not in HIDDEN_STATES]


def load_agents():
    """Registered ad-hoc free agents: [{id,name}, ...]."""
    try:
        with open(AGENTS) as f:
            data = json.load(f)
        return data if isinstance(data, list) else []
    except (OSError, ValueError):
        return []


def order_tickets(tickets, live):
    """Tickets with a live session float to the top; order is otherwise
    preserved (stable sort)."""
    return sorted(tickets, key=lambda t: t.get("id", "?") not in live)


def build_items(tickets, agents):
    """Flat navigable list: tickets first, then free agents."""
    items = [{"kind": "ticket", "id": t.get("id", "?"), "data": t} for t in tickets]
    items += [{"kind": "agent", "id": a.get("id", "?"), "data": a} for a in agents]
    return items


def build_rows(tickets, agents):
    """Display rows, item_idx aligned to build_items():
       ("ticket", t, i) | ("header", label) | ("agent", a, i)."""
    rows, i = [], 0
    for t in tickets:
        rows.append(("ticket", t, i)); i += 1
    rows.append(("header", "Free agents  (a add · x remove)"))
    for a in agents:
        rows.append(("agent", a, i)); i += 1
    return rows


def live_tickets():
    try:
        out = subprocess.run(
            [TMUX, "list-windows", "-t", SESSION, "-F",
             "#{@ticket}|#{window_name}|#{@shown}|#{@shown_kind}"],
            capture_output=True, text=True, timeout=2,
        )
        ids = set()
        for ln in out.stdout.splitlines():
            opt, name, shown, kind = (ln.split("|", 3) + ["", "", "", ""])[:4]
            if opt.strip():
                ids.add(opt.strip())
            elif name.strip():
                first = name.split(" ", 1)[0]
                if TICKET_RE.match(first):
                    ids.add(first)
            # A ticket whose claude is joined into the cockpit has no standalone
            # window but is genuinely live — surface it via @shown. Only when a
            # real session is joined (@shown_kind == "claude"): a blank preview
            # placeholder (kind "blank") must NOT count as live, otherwise merely
            # arrowing onto a session-less ticket badges it green and floats it
            # to the top, churning the list out from under the cursor.
            if shown.strip() and kind.strip() == "claude":
                ids.add(shown.strip())
        return ids
    except Exception:
        return set()


def cockpit_shown():
    """Ticket currently joined into the cockpit's right pane ("" if none)."""
    try:
        out = subprocess.run(
            [TMUX, "list-windows", "-t", SESSION, "-F", "#{@shown}"],
            capture_output=True, text=True, timeout=2,
        )
        for ln in out.stdout.splitlines():
            if ln.strip():
                return ln.strip()
    except Exception:
        pass
    return ""


def cockpit_right_pane():
    """The cockpit's content pane (the one that isn't this dashboard), or "" if
    the split isn't up. list-panes -t <our pane> scopes to the cockpit window."""
    dash = os.environ.get("TMUX_PANE", "")
    try:
        out = subprocess.run(
            [TMUX, "list-panes", "-t", dash, "-F", "#{pane_id}"],
            capture_output=True, text=True, timeout=2,
        )
        for p in out.stdout.split():
            if p and p != dash:
                return p
    except Exception:
        pass
    return ""


def focused_ticket():
    """The ticket/agent id whose claude pane is currently focused, else "".
    Looking at a finished session counts as reading it (blue dot -> green)."""
    try:
        out = subprocess.run(
            [TMUX, "display-message", "-p", "-t", SESSION,
             "#{@ticket}|#{@cockpit}|#{@shown}|#{@shown_kind}|#{pane_id}|#{@dashpane}"],
            capture_output=True, text=True, timeout=2,
        )
        at, cockpit, shown, kind, pane, dash = (out.stdout.strip().split("|") + [""] * 6)[:6]
        if cockpit == "1":
            return shown if (shown and kind == "claude" and pane and pane != dash) else ""
        return at
    except Exception:
        return ""


def write_selected(ticket_id):
    try:
        with open(SELECTED, "w") as f:
            f.write(ticket_id + "\n")
    except OSError:
        pass


def read_selected():
    try:
        with open(SELECTED) as f:
            return f.read().strip()
    except OSError:
        return ""


def run_bg(args):
    subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def mark_cockpit():
    """Tag this dashboard's window as the cockpit and record its pane id, so
    gl-split/gl-open can join/break ticket panes alongside it."""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return
    for opt, val in (("@cockpit", "1"), ("@dashpane", pane)):
        try:
            subprocess.run([TMUX, "set-window-option", "-t", pane, opt, val],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=2)
        except Exception:
            pass
    # The cockpit is never a ticket window; clear any stray @ticket so it isn't
    # mistaken for one (gl_window_for) or shown as a live session badge.
    try:
        subprocess.run([TMUX, "set-window-option", "-t", pane, "-u", "@ticket"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass


def fetch_blocking(stdscr):
    h, w = stdscr.getmaxyx()
    msg = " Refreshing from Linear… "
    try:
        stdscr.addstr(h // 2, max(0, (w - len(msg)) // 2), msg, curses.A_REVERSE)
        stdscr.refresh()
    except curses.error:
        pass
    subprocess.run([os.path.join(BIN, "gl-fetch")], capture_output=True)


def pr_cells(pr):
    """Return (pr_text, pr_color, review_text, review_color)."""
    if not pr or not pr.get("number"):
        return ("", 0, "", 0)
    num = pr.get("number")
    checks = pr.get("checks", "none")
    state = (pr.get("state") or "OPEN").upper()
    draft = pr.get("draft")
    mark = {"pass": "✓", "fail": "✗", "pending": "•", "none": "·"}.get(checks, "·")
    label = "draft" if draft else state.lower()
    color = {"pass": 3, "fail": 4, "pending": 5}.get(checks, 0)
    if state == "MERGED":
        color, label = 6, "merged"
    elif state == "CLOSED":
        color, label = 4, "closed"
    review = pr.get("review", "")
    rtext, rcolor = {
        "approved": ("appr", 3),
        "changes": ("chg!", 4),
        "review": ("req", 5),
    }.get(review, ("", 0))
    if pr.get("mergeable") == "CONFLICTING":
        rtext, rcolor = "conflx", 4
    return (f"#{num} {mark} {label}", color, rtext, rcolor)


def add_seg(stdscr, y, x, text, width, color, selected, maxw):
    """Write a fixed-width segment, return the next x."""
    cell = text[:width].ljust(width)
    if x >= maxw:
        return x
    cell = cell[:maxw - x]
    attr = curses.A_REVERSE if selected else (curses.color_pair(color) if color else 0)
    try:
        stdscr.addstr(y, x, cell, attr)
    except curses.error:
        pass
    return x + len(cell)


# --- daily info cards (below the ticket list) --------------------------------

def today_str():
    return time.strftime("%Y-%m-%d", time.localtime())


def load_registry():
    """The 2x2 grid slots: exactly 4 entries, each a block id or None."""
    try:
        with open(BLOCKS_REGISTRY) as f:
            slots = (json.load(f) or {}).get("slots") or []
    except (OSError, ValueError):
        slots = []
    slots = [(s or None) for s in slots][:4]
    return slots + [None] * (4 - len(slots))


def load_block_output(bid):
    """A block's cached render payload ($BLOCKS_DIR/<id>/output.json); None if absent."""
    try:
        with open(os.path.join(BLOCKS_DIR, bid, "output.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def load_block_spec(bid):
    try:
        with open(os.path.join(BLOCKS_DIR, bid, "spec.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def load_unread():
    """Ids with a finished-but-unopened session (one marker file each)."""
    try:
        return set(os.listdir(UNREAD_DIR))
    except OSError:
        return set()


def wrap_text(text, width):
    """Word-wrap into lines, keeping blank-line paragraph breaks."""
    width = max(4, width)
    out = []
    for para in (text or "").split("\n"):
        para = para.rstrip()
        out.extend(textwrap.wrap(para, width) if para else [""])
    return out


def compute_layout(h, n_rows):
    """(body_top, list_h, cards_h). The cards fill the space beneath a short
    list when the terminal is tall enough; otherwise it's list-only."""
    body_top = 2
    body_h = max(1, h - body_top - 1)          # rows body_top..h-2 (footer at h-1)
    if body_h < 18:
        return body_top, body_h, 0
    cards_min = 12
    list_h = max(3, min(n_rows, body_h - cards_min))
    return body_top, list_h, body_h - list_h


# The render contract: a block's output.json is {title, elements:[…]} where each
# element is one of a small set of typed shapes. One renderer draws them all, so
# any user-authored block renders with no dashboard changes.

def element_lines(el, width):
    t = el.get("type")
    if t == "section":
        return wrap_text(f'{el.get("label", "")} — {el.get("text", "")}', width)
    if t == "metric":
        head = ((f'{el.get("label")}: ' if el.get("label") else "")
                + str(el.get("value", ""))
                + (f'  ({el.get("sub")})' if el.get("sub") else ""))
        return wrap_text(head, width)
    if t == "kv":
        out = []
        for pair in (el.get("pairs") or []):
            if isinstance(pair, (list, tuple)) and len(pair) == 2:
                out.extend(wrap_text(f"{pair[0]}: {pair[1]}", width))
        return out
    if t == "list":
        out = []
        for it in (el.get("items") or []):
            out.extend(wrap_text("• " + str(it), width))
        return out
    if t == "quote":
        out = wrap_text("“" + el.get("text", "") + "”", width)
        if el.get("cite"):
            out.append("— " + str(el["cite"]))
        return out
    return wrap_text(el.get("text", ""), width)          # "text" and unknown


def block_body_lines(o, width):
    if not o or o.get("status") == "generating":
        return ["composing…"]
    if o.get("status") == "error":
        return ["(couldn't refresh — will retry)"]
    lines = []
    for el in (o.get("elements") or []):
        if lines:
            lines.append("")                              # blank between elements
        lines.extend(element_lines(el, width))
    return lines or ["(empty)"]


def draw_card(stdscr, top, x0, height, cw, heading, lines, accent, offset=0, editable=True):
    """Draw one grid cell: a heading rule (with an [edit] affordance in the
    top-right corner) and word-wrapped body, scrolled by `offset` lines within
    the fixed box. Content that overflows is reached by the mouse wheel; markers
    show there's more above/below."""
    if height < 2 or cw < 8:
        return
    inner = cw - 1                                        # gutter between columns
    edit = " [edit]" if editable else ""                 # ASCII so every font shows it
    rule = ("── " + heading + " ").ljust(max(0, inner - len(edit)), "─")[:max(0, inner - len(edit))] + edit
    attr = curses.A_BOLD | (curses.color_pair(accent) if accent else 0)
    try:
        stdscr.attron(attr)
        stdscr.addnstr(top, x0, rule, inner)
        stdscr.attroff(attr)
    except curses.error:
        pass
    avail = height - 1
    total = len(lines)
    if avail <= 0:
        return
    if total <= avail:
        window = lines[:avail]
    else:
        off = max(0, min(offset, total - avail))
        window = list(lines[off:off + avail])
        if off > 0:                                      # more scrolled off the top
            window[0] = "  ^ more above"
        if off + avail < total:                          # more below
            window[-1] = "  v %d more" % (total - off - avail)
    for i, ln in enumerate(window):
        try:
            stdscr.addnstr(top + 1 + i, x0 + 1, ln[:inner - 1], inner - 1)
        except curses.error:
            pass


def draw_empty_slot(stdscr, top, x0, height, cw):
    if height < 2 or cw < 8:
        return
    inner = cw - 1
    try:
        stdscr.attron(curses.A_DIM)
        stdscr.addnstr(top, x0, ("── empty ").ljust(inner - 6, "─")[:inner - 6] + " [add] ", inner)
        stdscr.addnstr(top + max(1, height // 2), x0 + 1,
                       "+ click [add] to create a block"[:inner - 1], inner - 1)
        stdscr.attroff(curses.A_DIM)
    except curses.error:
        pass


def cell_rects(cards_top, cards_h, w):
    """The four cell rectangles (TL, TR, BL, BR): (top, x0, height, width)."""
    row_h = cards_h // 2
    col_w = w // 2
    return [
        (cards_top,          0,     row_h,           col_w),
        (cards_top,          col_w, row_h,           w - col_w),
        (cards_top + row_h,  0,     cards_h - row_h, col_w),
        (cards_top + row_h,  col_w, cards_h - row_h, w - col_w),
    ]


def draw_grid(stdscr, cards_top, cards_h, w, slots, outs, specs, scroll):
    if cards_h < 4:
        return
    for i, (top, x0, ch, cw) in enumerate(cell_rects(cards_top, cards_h, w)):
        bid = slots[i] if i < len(slots) else None
        if not bid:
            draw_empty_slot(stdscr, top, x0, ch, cw)
            continue
        o = outs.get(bid)
        heading = (o or {}).get("title") or (specs.get(bid) or {}).get("title") or bid
        accent = 6 if i % 2 == 0 else 5
        draw_card(stdscr, top, x0, ch, cw, heading, block_body_lines(o, cw - 3), accent,
                  offset=scroll.get(bid, 0))


def draw(stdscr, rows, idx, top, live, status_line, shown, n_tickets, n_agents, slots, outs, specs, unread, scroll):
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    title = "  Linear — my active tickets"
    count = (f"{n_tickets} tickets · {n_agents} agents · {len(live)} live "
             + (f"· {len(unread)} unread " if unread else " "))
    stdscr.attron(curses.A_BOLD)
    stdscr.addnstr(0, 0, title.ljust(max(0, w - len(count))) + count, w - 1)
    stdscr.attroff(curses.A_BOLD)
    stdscr.hline(1, 0, curses.ACS_HLINE, w)

    body_top, list_h, cards_h = compute_layout(h, len(rows))
    maxw = w - 1

    for row, entry in enumerate(rows[top:top + list_h]):
        y = body_top + row
        kind = entry[0]

        if kind == "header":
            try:
                stdscr.attron(curses.A_DIM)
                stdscr.addnstr(y, 0, ("── " + entry[1] + " ").ljust(maxw, "─")[:maxw], maxw)
                stdscr.attroff(curses.A_DIM)
            except curses.error:
                pass
            continue

        _, obj, i = entry
        sel = (i == idx)
        if sel:
            stdscr.attron(curses.A_REVERSE)
            try:
                stdscr.addstr(y, 0, " ".ljust(maxw))
            except curses.error:
                pass
            stdscr.attroff(curses.A_REVERSE)

        bid = obj.get("id", "?")
        if bid in unread:                       # finished, not yet opened
            dot, dcol = "●", 7                  # blue
        elif bid in live:                       # live session
            dot, dcol = "●", 3                  # green
        else:
            dot, dcol = " ", 0
        x = add_seg(stdscr, y, 0, f" {dot} ", 3, dcol, sel, maxw)
        if kind == "ticket":
            state = obj.get("state") or ""
            prtext, prcolor, rtext, rcolor = pr_cells(obj.get("pr"))
            title_w = max(10, maxw - 3 - 11 - 13 - 16 - 7)
            x = add_seg(stdscr, y, x, obj.get("id", "?"), 11, 0, sel, maxw)
            x = add_seg(stdscr, y, x, state, 13, 0, sel, maxw)
            x = add_seg(stdscr, y, x, prtext, 16, prcolor, sel, maxw)
            x = add_seg(stdscr, y, x, rtext, 7, rcolor, sel, maxw)
            x = add_seg(stdscr, y, x, obj.get("title") or "", title_w, 0, sel, maxw)
        else:  # agent
            x = add_seg(stdscr, y, x, obj.get("id", "?"), 11, 0, sel, maxw)
            name = obj.get("name") or ""
            if name == obj.get("id"):
                name = "claude (free agent)"
            x = add_seg(stdscr, y, x, name, max(10, maxw - x), 0, sel, maxw)

    if cards_h > 0:
        draw_grid(stdscr, body_top + list_h, cards_h, w, slots, outs, specs, scroll)

    split = f" · ▶ {shown}" if shown else ""
    footer = (" ↑/↓ move · ⏎ open · y split" + split +
              " · a add · x remove · 1-4 blocks · g back · r refresh · q detach ")
    try:
        stdscr.attron(curses.A_DIM)
        stdscr.addnstr(h - 1, 0, (status_line or footer)[:maxw], maxw)
        stdscr.attroff(curses.A_DIM)
    except curses.error:
        pass
    stdscr.refresh()


def main(stdscr):
    mark_cockpit()
    curses.curs_set(0)
    curses.use_default_colors()
    for i, fg in [(3, curses.COLOR_GREEN), (4, curses.COLOR_RED),
                  (5, curses.COLOR_YELLOW), (6, curses.COLOR_MAGENTA),
                  (7, curses.COLOR_BLUE)]:
        try:
            curses.init_pair(i, fg, -1)
        except curses.error:
            pass
    # Mouse: single-click selects a row, double-click opens a ticket in Linear.
    # (Terminals can't report macOS Cmd, so the gesture is double-click, not
    # Cmd-click.) mouseinterval > 0 is required for double-click detection.
    try:
        mask = (curses.BUTTON1_CLICKED | curses.BUTTON1_DOUBLE_CLICKED
                | curses.BUTTON1_PRESSED)
        mask |= getattr(curses, "BUTTON4_PRESSED", 0)   # wheel up   (scroll blocks)
        mask |= getattr(curses, "BUTTON5_PRESSED", 0)   # wheel down
        curses.mousemask(mask)
        curses.mouseinterval(250)
    except curses.error:
        pass
    # Short poll so cycling feels live; expensive work (tmux queries, re-marking
    # the cockpit) is throttled below so we don't spawn subprocesses 8×/sec.
    stdscr.timeout(120)
    POLL_SECS = 1.0          # how often to re-query tmux for live/split state
    MARK_SECS = 2.0          # how often to re-assert @cockpit/@dashpane
    PREVIEW_DEBOUNCE = 0.22  # settle time before previewing the selection

    tickets = load_tickets()
    if not tickets:
        fetch_blocking(stdscr)
        tickets = load_tickets()
    agents = load_agents()
    items = build_items(tickets, agents)

    idx = 0
    sel = read_selected()
    if sel:
        for i, it in enumerate(items):
            if it["id"] == sel:
                idx = i
                break
    top = 0
    now = time.time()
    last_fetch = now
    last_poll = 0.0
    last_mark = 0.0
    live = set()
    unread = set()       # ids with a finished, unopened session (blue dot)
    shown = ""
    slots = []           # 2x2 grid block ids, loaded each poll
    block_outs = {}      # id -> output.json payload
    block_specs = {}     # id -> spec.json
    block_scroll = {}    # id -> wheel scroll offset (lines) within its fixed box
    last_block_sweep = 0.0
    last_autofix_sweep = 0.0
    pending = None       # id whose preview is waiting to settle
    pending_ts = 0.0
    status_line = ""
    last_order = None

    while True:
        now = time.time()

        if now - last_mark >= MARK_SECS:
            mark_cockpit()
            last_mark = now

        if now - last_poll >= POLL_SECS:
            live = live_tickets()
            foc = focused_ticket()          # viewing a finished session = reading it
            if foc:
                try:
                    os.remove(os.path.join(UNREAD_DIR, foc))
                except OSError:
                    pass
            unread = load_unread()
            shown = cockpit_shown()
            agents = load_agents()
            last_poll = now
            if now - last_fetch > REFETCH_SECONDS:
                fetch_blocking(stdscr)
                tickets = load_tickets()
                last_fetch = time.time()
            # Info-card grid: load each slot's cached output for rendering, and
            # on a slow throttle ask gl-block to refresh each block (gl-block
            # owns freshness per the block's cadence and no-ops when fresh).
            slots = load_registry()
            block_outs = {b: load_block_output(b) for b in slots if b}
            block_specs = {b: load_block_spec(b) for b in slots if b}
            if now - last_block_sweep >= 30:
                for b in slots:
                    if b:
                        run_bg([os.path.join(BIN, "gl-block"), b])
                last_block_sweep = now
            # Autofix sweep: pick up idle+conflicting sessions the Stop hook
            # missed (gl-autofix --sweep skips busy sessions and non-conflicts).
            if now - last_autofix_sweep >= 90:
                run_bg([os.path.join(BIN, "gl-autofix"), "--sweep"])
                last_autofix_sweep = now

        tickets_view = order_tickets(tickets, live)   # live sessions on top
        items = build_items(tickets_view, agents)
        rows = build_rows(tickets_view, agents)
        n = len(items)
        idx = max(0, min(idx, n - 1)) if n else 0

        # Publish the visible order so gl-cycle (cmd+`) matches the screen.
        order = "\n".join(it["id"] for it in items)
        if order != last_order:
            try:
                with open(ORDER, "w") as f:
                    f.write(order + ("\n" if order else ""))
            except OSError:
                pass
            last_order = order

        h, _ = stdscr.getmaxyx()
        _bt, list_h, _ch = compute_layout(h, len(rows))
        body_h = list_h          # paging / scroll follow the visible list height

        # Follow the shared selection so cmd+` / gl-cycle (separate processes)
        # move the highlight here too.
        sel = read_selected()
        if sel and n and (idx >= n or items[idx]["id"] != sel):
            for i, it in enumerate(items):
                if it["id"] == sel:
                    idx = i
                    break

        # Keep the selected item's display row on screen (rows include the
        # non-selectable "Free agents" header).
        sel_row = next((r for r, e in enumerate(rows) if e[0] != "header" and e[2] == idx), 0)
        if sel_row < top:
            top = sel_row
        elif sel_row >= top + body_h:
            top = sel_row - body_h + 1
        top = max(0, min(top, max(0, len(rows) - 1)))

        if pending is not None and now - pending_ts >= PREVIEW_DEBOUNCE:
            run_bg([os.path.join(BIN, "gl-preview"), pending])
            pending = None

        draw(stdscr, rows, idx, top, live, status_line, shown, len(tickets), len(agents),
             slots, block_outs, block_specs, unread, block_scroll)
        status_line = ""

        try:
            c = stdscr.getch()
        except KeyboardInterrupt:
            c = -1

        if c == -1:
            continue

        # Paste / drag-drop guard. A real keypress arrives alone within a poll
        # window; a paste (e.g. Ghostty pasting a dropped image's shell-escaped
        # file path) dumps many characters at once. Drain what's already queued:
        # if a burst follows, it's a paste/drop, so swallow the whole thing
        # instead of running each character as a command. Without this, path
        # characters fire destructive keys — 'a' (add agent), the 'x' in a
        # "1920x1080" filename (remove agent), a stray 'q' (detach) — which is
        # the "spawns agents / kills agents / crashes" bug.
        stdscr.timeout(0)                 # non-blocking: drain the input buffer
        burst = 0
        while stdscr.getch() != -1:
            burst += 1
            if burst > 8192:              # pathologically large paste; stop draining
                break
        stdscr.timeout(120)               # restore the normal poll cadence
        if burst >= 3:
            status_line = " ignored paste/drop — focus a claude pane before dropping an image "
            continue

        cur = items[idx] if n else None
        moved = False
        if c == curses.KEY_MOUSE:
            try:
                _mid, mx, my, _mz, bstate = curses.getmouse()
            except curses.error:
                bstate, mx, my = 0, -1, -1
            mh, mw = stdscr.getmaxyx()
            _bt, l_h, c_h = compute_layout(mh, len(rows))
            cards_top = 2 + l_h
            wheel = bstate & (getattr(curses, "BUTTON4_PRESSED", 0)
                              | getattr(curses, "BUTTON5_PRESSED", 0))
            if c_h > 0 and my >= cards_top:
                # In the 2x2 block grid: wheel scrolls a block's content within its
                # fixed box; the [edit] title bar (or anywhere in an empty cell)
                # opens that slot's authoring session.
                for si, (cy, cx, ch, cwid) in enumerate(cell_rects(cards_top, c_h, mw)):
                    if cy <= my < cy + ch and cx <= mx < cx + cwid:
                        bid = slots[si] if si < len(slots) else None
                        if wheel and bid:
                            n_lines = len(block_body_lines(block_outs.get(bid), cwid - 3))
                            maxoff = max(0, n_lines - (ch - 1))
                            step = -3 if (bstate & getattr(curses, "BUTTON4_PRESSED", 0)) else 3
                            block_scroll[bid] = max(0, min(block_scroll.get(bid, 0) + step, maxoff))
                        elif not wheel and (bid is None or my == cy):
                            run_bg([os.path.join(BIN, "gl-block-edit"), str(si)])
                            status_line = f" configuring block {si + 1} — chat on the right "
                        break
            else:
                row_i = top + (my - 2)      # body rows start at screen row 2
                if 0 <= row_i < len(rows) and rows[row_i][0] != "header":
                    item_idx = rows[row_i][2]
                    if bstate & curses.BUTTON1_DOUBLE_CLICKED:
                        it = items[item_idx]
                        url = it["data"].get("url") if it["kind"] == "ticket" else None
                        if url:
                            run_bg(["open", url])
                            status_line = f" opening {it['id']} in Linear "
                        else:
                            status_line = " no Linear URL for that row "
                    else:                    # single click: select (+ preview via tail)
                        idx = item_idx; moved = True
        elif c in (curses.KEY_UP, ord("k")):
            idx = max(0, idx - 1); moved = True
        elif c in (curses.KEY_DOWN, ord("j")):
            idx = min(n - 1, idx + 1) if n else 0; moved = True
        elif c == curses.KEY_NPAGE:
            idx = min(n - 1, idx + body_h) if n else 0; moved = True
        elif c == curses.KEY_PPAGE:
            idx = max(0, idx - body_h); moved = True
        elif c in (curses.KEY_RIGHT, ord("l")):
            # Hop into the right (content) pane. If the split is already up, just
            # move focus there; otherwise open the current selection into it
            # (gl-split shows it and lands focus on the right). Doesn't start a
            # session — that's still Enter.
            rp = cockpit_right_pane()
            if rp:
                run_bg([TMUX, "select-pane", "-t", rp])
                status_line = " → right pane "
            elif cur:
                run_bg([os.path.join(BIN, "gl-split"), cur["id"]])
        elif c in (ord("1"), ord("2"), ord("3"), ord("4")):
            # Keyboard path to the block grid (TL,TR,BL,BR = 1,2,3,4): configure
            # that slot (creates a new block if it's empty).
            run_bg([os.path.join(BIN, "gl-block-edit"), str(c - ord("1"))])
            status_line = f" configuring block {chr(c)} — chat on the right "
        elif c in (curses.KEY_ENTER, 10, 13):
            if cur:
                run_bg([os.path.join(BIN, "gl-open"), cur["id"]])
                pending = None
        elif c == ord("y"):
            if cur:
                run_bg([os.path.join(BIN, "gl-split"), cur["id"]])
                pending = None
        elif c == ord("a"):
            run_bg([os.path.join(BIN, "gl-agent"), "add"])
            status_line = " spawning free agent… "
            last_poll = 0.0     # reload the agent list promptly
        elif c == ord("x"):
            if cur and cur["kind"] == "agent":
                run_bg([os.path.join(BIN, "gl-agent"), "remove", cur["id"]])
                status_line = f" removed {cur['id']} "
                last_poll = 0.0
            else:
                status_line = " x removes a free agent (select one) "
        elif c == ord("g"):
            run_bg([os.path.join(BIN, "gl-return")])
        elif c == ord("o"):
            if cur and cur["kind"] == "ticket" and cur["data"].get("url"):
                run_bg(["open", cur["data"]["url"]])
        elif c == ord("r"):
            fetch_blocking(stdscr)
            tickets = load_tickets()
            last_fetch = time.time()
            status_line = " refreshed "
        elif c == ord("q"):
            subprocess.run([TMUX, "detach-client"])

        if moved and n:
            write_selected(items[idx]["id"])
            pending = items[idx]["id"]
            pending_ts = now


if __name__ == "__main__":
    while True:
        try:
            curses.wrapper(main)
            break
        except KeyboardInterrupt:
            continue
        except Exception as e:  # keep the window alive on unexpected errors
            print(f"\n[ghostty-linear] dashboard error: {e}\nRestarting in 2s… (Ctrl-C to stop)")
            time.sleep(2)
