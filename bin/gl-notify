#!/usr/bin/env bash
# Claude Code "Stop" hook (and Codex `notify`) handler for arcade sessions: when a ticket/agent
# session finishes a turn, fire a macOS notification and mark it "unread" (a
# marker the dashboard turns into a blue dot). No-op for non-arcade claude
# sessions and when the user is already looking at that session's pane.
#
# Which session fired is taken from $GL_TICKET (exported at launch); if absent,
# from the payload's `cwd` when it's a ticket worktree.
#
# Claude sends its hook JSON on stdin. Codex passes an `agent-turn-complete`
# JSON as the last argv (and stdin may be a tty, so it must not be read); it is
# normalized to the Claude field names used below.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=gl-lib.sh
. "$DIR/gl-lib.sh"

agent="Claude"
if [ "$#" -gt 0 ]; then
  [ "$(printf '%s' "${!#}" | jq -r '.type // empty' 2>/dev/null || true)" = "agent-turn-complete" ] || exit 0
  agent="Codex"
  payload="$(printf '%s' "${!#}" | jq -c '{cwd, session_id: .["thread-id"], last_assistant_message: .["last-assistant-message"]}' 2>/dev/null || true)"
else
  payload="$(cat 2>/dev/null || true)"
fi

id="${GL_TICKET:-}"
if [ -z "$id" ]; then
  cwd="$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null || true)"
  case "$cwd" in
    "$GL_WORKTREE_BASE"/*) id="$(basename "$cwd" | tr '[:lower:]' '[:upper:]')" ;;
  esac
fi
[ -n "$id" ] || exit 0                      # not an arcade session
gl_session_exists || exit 0

# If this ticket's PR is conflicting, hand the fix to this now-idle session
# instead of notifying (rebase + resolve + push, capped at 5 tries/session).
sid="$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null || true)"
af=0; "$DIR/gl-autofix" "$id" "$sid" || af=$?
case "$af" in
  0) exit 0 ;;                              # pasted "fix conflict" — don't also notify
  3)                                        # hit the retry cap — a human needs to look
    nt="$(gl_title "$id" 2>/dev/null || printf '%s' "$id")"; nt="$(printf '%s' "$nt" | tr -d '"\\')"
    osascript -e "display notification \"conflict needs manual fix\" with title \"${nt:-$id}\" sound name \"Basso\"" >/dev/null 2>&1 || true
    mkdir -p "$GL_CACHE/unread" 2>/dev/null || true; : > "$GL_CACHE/unread/$id" 2>/dev/null || true
    exit 0 ;;
esac
# af 1/2 = no conflict / not applicable: fall through to the normal notification.

# Don't nag if the user is currently looking at this session's pane. Inspect the
# attached session's active window/pane.
watching=0
info="$("$TMUX_BIN" display-message -p -t "$GL_SESSION" \
  '#{@ticket}|#{@cockpit}|#{@shown}|#{@shown_kind}|#{pane_id}|#{@dashpane}' 2>/dev/null || true)"
IFS='|' read -r a_ticket a_cockpit a_shown a_kind a_pane a_dash <<< "$info"
if [ "$a_cockpit" = "1" ]; then
  [ "$a_shown" = "$id" ] && [ "$a_kind" = "claude" ] && [ -n "$a_pane" ] && [ "$a_pane" != "$a_dash" ] && watching=1
else
  [ "$a_ticket" = "$id" ] && watching=1
fi
[ "$watching" = "1" ] && exit 0

# Dedupe: a single finish can surface as two Stops (double-fire, or a transient
# duplicate window). Skip if we already notified for this id in the last 10s —
# distinct finishes seconds apart are rare; near-simultaneous ones are the bug.
ndir="$GL_CACHE/notify"; mkdir -p "$ndir" 2>/dev/null || true
nstamp="$ndir/$id"; nows="$(date +%s)"
last="$(cat "$nstamp" 2>/dev/null || echo 0)"; case "$last" in ''|*[!0-9]*) last=0;; esac
[ "$((nows - last))" -lt 10 ] && exit 0
printf '%s' "$nows" > "$nstamp"

# Notify (macOS). The body says what the turn actually did -- gl-summary reads
# the closing message and the files it touched out of the transcript -- so the
# notification is worth reading without switching to the pane. Sanitize both
# strings for AppleScript literals.
ntitle="$(gl_title "$id" 2>/dev/null || printf '%s' "$id")"
ntitle="$(printf '%s' "$ntitle" | tr -d '"\\')"
tpath="$(printf '%s' "$payload" | jq -r '.transcript_path // empty' 2>/dev/null || true)"
lastmsg="$(printf '%s' "$payload" | jq -r '.last_assistant_message // empty' 2>/dev/null || true)"
nbody=""
if [ -n "$tpath" ] && [ -f "$tpath" ]; then
  nbody="$("$DIR/gl-summary" "$tpath" 2>/dev/null || true)"
elif [ -n "$lastmsg" ]; then
  nbody="$(printf '%s' "$lastmsg" | "$DIR/gl-summary" --text 2>/dev/null || true)"
fi
[ -n "$nbody" ] || nbody="$agent finished"
nbody="$(printf '%s' "$nbody" | tr -d '"\\' | tr '\n' ' ')"
osascript -e "display notification \"$nbody\" with title \"${ntitle:-$id}\" sound name \"Tink\"" >/dev/null 2>&1 || true

# Mark unread (dashboard shows a blue dot until the item is opened).
mkdir -p "$GL_CACHE/unread" 2>/dev/null || true
: > "$GL_CACHE/unread/$id" 2>/dev/null || true
exit 0
